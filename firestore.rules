rules_version = '2';

// Chasyn To-Do security rules.
// Paste this into Firebase console > Firestore Database > Rules, then Publish.
//
// - Anyone with the link can READ tasks (the TV board needs this, no login).
// - Only signed-in Google accounts listed in config/editors can CHANGE tasks.
//   Add or remove team members in Firestore > config > editors > emails.
service cloud.firestore {
  match /databases/{database}/documents {

    function isEditor() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in
           get(/databases/$(database)/documents/config/editors).data.emails;
    }

    function validTask(d) {
      return d.keys().hasOnly(['title', 'done', 'order', 'notes', 'createdAt', 'doneAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 300
        && d.done is bool
        && d.order is number
        && (!('notes' in d) || (d.notes is string && d.notes.size() <= 5000));
    }

    match /tasks/{taskId} {
      allow read: if true;
      allow create, update: if isEditor() && validTask(request.resource.data);
      allow delete: if isEditor();
    }

    // Email cards: team only. Only the Email Sync script (running as the
    // project owner) writes them, so nobody can change them from the page.
    match /emails/{threadId} {
      allow read: if isEditor();
      allow write: if false;
    }
    match /emailsMeta/{doc} {
      allow read: if isEditor();
      allow write: if false;
    }

    // The team list itself is private; only the rules above read it.
    match /config/{doc} {
      allow read, write: if false;
    }
  }
}
